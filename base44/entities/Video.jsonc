{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "videoUrl": {
      "type": "string"
    },
    "thumbnailUrl": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Process",
        "Time-lapse",
        "Tutorial",
        "Behind the Scenes",
        "Commission Reveal",
        "Other"
      ]
    },
    "duration": {
      "type": "string"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "videoUrl"
  ]
}