{
  "name": "ShopProduct",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Print",
        "Framed",
        "Digital Download",
        "Original"
      ]
    },
    "imageUrl": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "stock": {
      "type": "number",
      "default": 1
    },
    "description": {
      "type": "string"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "dimensions": {
      "type": "string"
    },
    "category": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type",
    "price"
  ]
}