NODE_ENV=development
API_PORT=43130
API_HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:43127
SITE_URL=http://127.0.0.1:43127
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Production database. Leave empty only for local JSON development.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_SIZE=5
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Persistent uploads: local or cloudinary. Use cloudinary in production.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Email for invitations, resets, confirmations and replies.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Operations
LOG_REQUESTS=false
