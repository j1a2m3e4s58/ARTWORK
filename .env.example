NODE_ENV=development
# Render supplies PORT automatically. API_PORT remains the local fallback.
PORT=
API_PORT=43130
API_HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:43127
SITE_URL=http://127.0.0.1:43127
TRUST_PROXY=false
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
REQUIRE_ADMIN_MFA=true
SEED_DEMO_CONTENT=false
BOOTSTRAP_PORTFOLIO_CONTENT=false

# Production database. Leave empty only for local JSON development.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_SIZE=5
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Persistent uploads: local or cloudinary. Use cloudinary in production.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
# Signed server-side credentials are required in production.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional unsigned preset for local testing only.
CLOUDINARY_UPLOAD_PRESET=

# Email for invitations, resets, confirmations and replies.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_MAX_CONNECTIONS=3
EMAIL_REQUIRED_FOR_READINESS=false

# Payments: manual or paystack. Paystack amounts are charged in pesewas.
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=GHS
SHIPPING_FLAT_RATE=0
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Operations
LOG_REQUESTS=false
ERROR_WEBHOOK_URL=
BACKUP_VERIFIED_AT=
EMAIL_LOG_RETENTION_DAYS=90
BACKGROUND_JOBS_ENABLED=true
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
METRICS_TOKEN=
