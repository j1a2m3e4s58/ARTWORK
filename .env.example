NODE_ENV=development
# Render supplies PORT automatically. API_PORT remains the local fallback.
PORT=
API_PORT=43130
API_HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:43127
SITE_URL=http://127.0.0.1:43127
TRUST_PROXY=false
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
REQUIRE_ADMIN_MFA=true
SEED_DEMO_CONTENT=false
BOOTSTRAP_PORTFOLIO_CONTENT=false

# Production database. Leave empty only for local JSON development.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_SIZE=5
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Persistent uploads: local or cloudinary. Use cloudinary in production.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
# Signed server-side credentials are required in production.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional unsigned preset for local testing only.
CLOUDINARY_UPLOAD_PRESET=

# Email for invitations, resets, confirmations and replies. Render free services
# block SMTP ports; use Resend (HTTPS) in production or use SMTP on a paid plan.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_MAX_CONNECTIONS=3
EMAIL_REQUIRED_FOR_READINESS=false
# Set EMAIL_PROVIDER=resend and add this key to use the HTTPS Resend API.
RESEND_API_KEY=

# Optional social sign-in. Keep blank until the providers are configured.
# Google callback: https://your-domain/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple callback: https://your-domain/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 private key as a single line using literal \n line breaks.
APPLE_PRIVATE_KEY=

# Payments: manual or paystack. Hosted Paystack checkout uses the server-side
# secret key for initialization and webhook verification. Never expose it to Vite.
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=GHS
SHIPPING_FLAT_RATE=0
PAYSTACK_SECRET_KEY=

# Operations
LOG_REQUESTS=false
ERROR_WEBHOOK_URL=
BACKUP_VERIFIED_AT=
# Separate secret used to AES-256-GCM encrypt local backups and restore rehearsals.
BACKUP_ENCRYPTION_KEY=
EMAIL_LOG_RETENTION_DAYS=90
BACKGROUND_JOBS_ENABLED=true
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
METRICS_TOKEN=
# Web push. Generate a matching pair with: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:armohbh123@gmail.com
# Optional: enables multi-instance real-time chat and distributed job locking.
REDIS_URL=
JOB_WORKER_CONCURRENCY=3
# Request-metered Redis plans should keep these well above BullMQ's defaults.
JOB_WORKER_DRAIN_DELAY_SECONDS=300
JOB_WORKER_STALLED_INTERVAL_MS=300000
# Optional malware scanner accepting raw file bytes and returning {"clean":true}.
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# WebRTC. STUN supports direct connections; at least one TURN URL is required
# for reliable production calls across mobile networks and strict firewalls.
STUN_URLS=stun:stun.l.google.com:19302
# Preferred managed option. Both values stay server-side; the API exchanges
# them for short-lived Cloudflare ICE credentials for each signed-in user.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Self-hosted coturn or another provider:
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Prefer time-limited TURN credentials when your coturn provider supports them.
TURN_SHARED_SECRET=
